KEEPA_API_KEY=
# Mercado Libre: solo si la API de búsqueda pide token (app en developers.mercadolibre.com.pe)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
FACTOR_IMPORTACION=1.25
SITE_BASE_URL=
